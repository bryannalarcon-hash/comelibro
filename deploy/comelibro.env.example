APP_ORIGIN=https://comelibro.bryannalarcon.com
DATA_DIR=/var/lib/comelibro
AI_PUBLIC_ENABLED=false
ADMIN_EMAILS=comelibro-test@mail.bryannalarcon.com
SMTP_HOST=127.0.0.1
SMTP_PORT=1587
SMTP_SERVERNAME=mail.bryannalarcon.com
SMTP_USER=comelibro@mail.bryannalarcon.com
SMTP_PASSWORD=replace-with-dedicated-mailbox-password
SMTP_FROM=comelibro@mail.bryannalarcon.com
# Optional demo and trusted-owner AI: set enabled=true only with BOTH values below configured.
# Public demo sessions and this owner can use AI; other regular accounts remain denied.
AI_SOCKET_PATH=/run/comelibro-ai/worker.sock
AI_ALLOWED_USER_ID=
